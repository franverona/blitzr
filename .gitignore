# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.vitest/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.claude/settings.local.json
.playwright-mcp

# SQLite database
/data/*.db
/data/*.db-shm
/data/*.db-wal
/data/backups/
# Polgár's book is copyrighted: the source PGN and its import stay local
/polgar.pgn
/data/polgar-mates.json

# Stockfish engine assets — copied from node_modules by scripts/setup-stockfish.js
/public/stockfish/
