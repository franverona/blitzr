{
  "name": "blitzr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "backup": "node scripts/backup-db.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preinstall": "node -e \"if (+process.versions.node.split('.')[0] < 22) { console.error('blitzr needs Node 22+ (see .nvmrc)'); process.exit(1) }\"",
    "prepare": "husky",
    "postinstall": "node scripts/setup-stockfish.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "chess.js": "^1.4.0",
    "kysely": "^0.29.6",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-chessboard": "^5.11.0",
    "react-dom": "19.3.1",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
