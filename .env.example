# Your Chess.com username (case-insensitive). Needed to sync games; without it
# the app still runs, but the games page shows a setup notice instead of syncing.
CHESSCOM_USERNAME=

# UI language: "en" (default) or "es". Needs the NEXT_PUBLIC_ prefix so
# client components can read it too — restart/rebuild after changing it.
# NEXT_PUBLIC_LOCALE=en

# Where the database, its backups and local-only puzzles live (default: ./data).
# Absolute (no ~, it isn't expanded), or relative to the repo root. Lets another checkout or a pm2 process
# started elsewhere share one database, and keeps backups out of the repo folder.
# BLITZR_DATA_DIR=/Users/you/blitzr-data

# Opening the app syncs on its own when the last sync is older than this many
# minutes (default 60). 0 turns auto-sync off.
# BLITZR_AUTO_SYNC_MINUTES=60
